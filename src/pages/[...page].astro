---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import {
	displayTitle,
	getIssueNumber,
	parseBriefItems,
} from '../lib/weekly';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const latestPost = isFirstPage ? page.data[0] : null;
const timelinePosts = isFirstPage ? page.data.slice(1) : page.data;

const latestIssue = latestPost ? getIssueNumber(latestPost.id) : null;
const latestBriefs = latestPost ? parseBriefItems(latestPost.body, 3) : [];
const latestDisplay = latestPost ? displayTitle(latestPost.data.title) : '';

const pageTitle = isFirstPage ? SITE_TITLE : `${SITE_TITLE} - 第 ${page.currentPage} 页`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-surface text-ink leading-relaxed">
		<Header />
		<main class="mx-auto w-full max-w-3xl px-6 py-10 md:px-8">

			{isFirstPage && latestPost && (
				<>
					{/* Compact hero */}
					<div class="mb-8 flex flex-wrap items-end justify-between gap-3 border-b border-border pb-6">
						<div>
							<p class="mb-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
								前端开发者技术周刊
							</p>
							<p class="text-sm text-ink-muted">精选新闻、文章与工具 · 每周一更新</p>
						</div>
						<a
							href="/rss.xml"
							class="text-sm font-medium text-accent no-underline hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
						>
							RSS 订阅
						</a>
					</div>

					{/* Featured: Brief-first */}
					<section class="mb-12">
						<p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
							本周最新{latestIssue != null ? ` · #${latestIssue}` : ''}
						</p>
						<article class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-sm">
							<div class="border-b border-border p-6 md:p-8">
								<div class="mb-2 flex items-baseline justify-between gap-4">
									<span class="font-mono text-xs text-ink-muted">
										<FormattedDate date={latestPost.data.pubDate} />
									</span>
									<span class="font-mono text-xs text-accent">最新一期</span>
								</div>
								<h1 class="mb-3 font-serif text-2xl font-bold leading-snug tracking-tight md:text-3xl">
									<a
										href={`/${latestPost.id}/`}
										class="text-ink no-underline transition-colors hover:text-accent"
									>
										{latestDisplay}
									</a>
								</h1>
								{latestPost.data.description && (
									<p class="text-sm leading-relaxed text-ink-muted">
										{latestPost.data.description}
									</p>
								)}
							</div>

							{latestBriefs.length > 0 && (
								<div class="bg-accent-soft/60 px-6 py-5 md:px-8">
									<p class="mb-3 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
										<span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
										本周快讯 · 先看这三条
									</p>
									<ol class="m-0 list-none space-y-2.5 p-0">
										{latestBriefs.map((item, i) => (
											<li class="flex gap-3 text-sm leading-snug">
												<span class="w-5 shrink-0 font-mono text-accent">
													{String(i + 1).padStart(2, '0')}
												</span>
												<a
													href={item.href}
													class="text-ink no-underline hover:text-accent"
													target={item.href.startsWith('http') ? '_blank' : undefined}
													rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
												>
													{item.title}
												</a>
											</li>
										))}
									</ol>
									<a
										href={`/${latestPost.id}/`}
										class="mt-5 inline-flex text-sm font-medium text-accent no-underline hover:underline"
									>
										阅读完整{latestIssue != null ? ` #${latestIssue}` : ''} →
									</a>
								</div>
							)}

							{latestBriefs.length === 0 && (
								<div class="px-6 py-4 md:px-8">
									<a
										href={`/${latestPost.id}/`}
										class="inline-flex text-sm font-medium text-accent no-underline hover:underline"
									>
										阅读完整{latestIssue != null ? ` #${latestIssue}` : ''} →
									</a>
								</div>
							)}
						</article>
					</section>
				</>
			)}

			{/* Timeline: past issues */}
			{timelinePosts.length > 0 && (
				<section>
					<p class="mb-6 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
						{isFirstPage ? '往期周刊' : `第 ${page.currentPage} 页`}
					</p>
					<div class="relative space-y-0 border-l-2 border-border pl-6">
						{timelinePosts.map((post, index) => {
							const issue = getIssueNumber(post.id);
							const title = displayTitle(post.data.title);
							const isFirst = index === 0;
							return (
								<div class:list={['relative', index < timelinePosts.length - 1 ? 'pb-8' : '']}>
									<span
										class:list={[
											'absolute top-1 h-3 w-3 rounded-full border-2 bg-surface',
											isFirst && isFirstPage ? 'border-accent' : 'border-border',
										]}
										style="left: -1.9rem;"
									></span>
									<div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
										{issue != null && (
											<span
												class:list={[
													'font-mono text-xs',
													isFirst && isFirstPage ? 'text-accent' : 'text-ink-muted',
												]}
											>
												#{issue}
											</span>
										)}
										<span class="font-mono text-xs text-ink-muted">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<h2 class="mb-1 font-serif text-lg font-semibold leading-snug">
										<a
											href={`/${post.id}/`}
											class="text-ink no-underline transition-colors hover:text-accent"
										>
											{title}
										</a>
									</h2>
									{post.data.description && (
										<p class="line-clamp-2 text-sm leading-relaxed text-ink-muted">
											{post.data.description}
										</p>
									)}
								</div>
							);
						})}
					</div>
				</section>
			)}

			{/* Pagination */}
			{page.lastPage > 1 && (
				<nav class="mt-12 flex items-center justify-center gap-2" aria-label="分页导航">
					{page.url.prev ? (
						<a href={page.url.prev} class="inline-flex items-center gap-1 rounded-lg border border-border bg-surface-card px-4 py-2 text-sm font-medium text-ink no-underline transition-colors duration-200 hover:border-accent hover:text-accent">
							← 上一页
						</a>
					) : (
						<span class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted opacity-40">
							← 上一页
						</span>
					)}

					{Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
						<a
							href={num === 1 ? '/' : `/${num}/`}
							class:list={[
								'inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium no-underline transition-colors duration-200',
								num === page.currentPage
									? 'bg-accent text-white'
									: 'border border-border bg-surface-card text-ink hover:border-accent hover:text-accent',
							]}
							aria-current={num === page.currentPage ? 'page' : undefined}
						>
							{num}
						</a>
					))}

					{page.url.next ? (
						<a href={page.url.next} class="inline-flex items-center gap-1 rounded-lg border border-border bg-surface-card px-4 py-2 text-sm font-medium text-ink no-underline transition-colors duration-200 hover:border-accent hover:text-accent">
							下一页 →
						</a>
					) : (
						<span class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted opacity-40">
							下一页 →
						</span>
					)}
				</nav>
			)}

		</main>
		<Footer />
	</body>
</html>
